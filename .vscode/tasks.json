{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": { "regexp": "Building|Changes detected" },
          "endsPattern": { "regexp": "bundle generation (complete|failed)" }
        }
      }
    },
    { "type": "npm", "script": "test", "problemMatcher": [] },
    { "type": "npm", "script": "build", "problemMatcher": [] },
    { "type": "npm", "script": "test:e2e", "problemMatcher": [] }
  ]
}
