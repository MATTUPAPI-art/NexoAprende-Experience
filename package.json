{
  "name": "nexoaprende-experience",
  "version": "0.1.0",
  "scripts": {
    "media:prepare": "node scripts/prepare-media.mjs",
    "media:optimize": "node scripts/optimize-art-media.mjs && node scripts/prepare-custom-art.mjs && node scripts/prepare-media.mjs",
    "media:art": "node scripts/prepare-custom-art.mjs && node scripts/prepare-media.mjs",
    "qa:visual": "node scripts/audit-visual.mjs",
    "prestart": "npm run media:prepare",
    "prebuild": "npm run media:prepare",
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4307",
    "build": "ng build",
    "build:pages": "npm run build && node scripts/verify-pages-build.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=desktop"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
